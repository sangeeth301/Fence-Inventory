public without sharing class NewWorkOrder {
    
    @AuraEnabled(cacheable=true)
    public static Map<String, Object> getProjects(String email, Boolean isExternal, String accountId) {
        
        
        // External user flow
        if (String.isNotBlank(accountId)) {
            // If accountId is provided, return projects for that specific account
            return new Map<String, Object>{
                'projects' => [SELECT Id, Name FROM Projects__c 
                              WHERE General_Contractor__c = :accountId 
                              ORDER BY Name],
                'accounts' => null
            };
        }
        else if (String.isNotBlank(email)) {
            // Check for contacts with this email
            List<Contact> contacts = [SELECT AccountId, Account.Name 
                                     FROM Contact 
                                     WHERE Email = :email 
                                     AND AccountId != null];
            
            if (!contacts.isEmpty()) {
                Set<Id> accountIds = new Set<Id>();
                for (Contact c : contacts) {
                    accountIds.add(c.AccountId);
                }
                
                if (accountIds.size() > 1) {
                    // Multiple accounts found - return them for selection
                    List<Account> accounts = [SELECT Id, Name 
                                            FROM Account 
                                            WHERE Id IN :accountIds 
                                            ORDER BY Name];
                    
                    return new Map<String, Object>{
                        'projects' => null,
                        'accounts' => accounts
                    };
                }
                else if (accountIds.size() == 1) {
                    // Single account found - return its projects
                    return new Map<String, Object>{
                        'projects' => [SELECT Id, Name FROM Projects__c 
                                      WHERE General_Contractor__c IN :accountIds 
                                      ORDER BY Name],
                        'accounts' => null
                    };
                }
            }
        }
        
        // Default return if no matches found
        return new Map<String, Object>{
            'projects' => new List<Projects__c>(),
            'accounts' => null
        };
    }
    
    // Optional: Add a method to get account details if needed
    @AuraEnabled(cacheable=true)
    public static List<Account> getAccountsForEmail(String email) {
        if (String.isBlank(email)) {
            return new List<Account>();
        }
        
        List<Contact> contacts = [SELECT AccountId 
                                FROM Contact 
                                WHERE Email = :email 
                                AND AccountId != null];
        
        Set<Id> accountIds = new Set<Id>();
        for (Contact c : contacts) {
            accountIds.add(c.AccountId);
        }
        
        return [SELECT Id, Name FROM Account WHERE Id IN :accountIds ORDER BY Name];
    }

    
  

    
    @AuraEnabled(cacheable=true)
    public static List<Account> getAccounts() {
        return [SELECT Id, Name FROM Account ORDER BY Name];
    }

    @AuraEnabled(cacheable=true)
    public static List<Contact> getContacts(Id accountId) {
        if (accountId == null) {
            return new List<Contact>();
        }
        return [
            SELECT Id, Name
            FROM Contact
            WHERE AccountId = :accountId
            ORDER BY Name
            LIMIT 100
        ];
    }

    
     @AuraEnabled(cacheable=true)
    public static Boolean isExternalUser() {
        // getUserType() will return things like 'Standard', 'Customer Community', 'Partner', etc.
        return UserInfo.getUserType() != 'Standard';
    }

    @AuraEnabled
    public static Id createProject(Map<String, Object> projectData) {
        Projects__c project = new Projects__c();
        project.General_Contractor__c = (Id)projectData.get('General_Contractor__c');
        project.Site_Super__c = (Id)projectData.get('Site_Super__c');
        project.Name = (String)projectData.get('Name');
        project.Project_Address__c = (String)projectData.get('Project_Address__c');
        project.City__c = (String)projectData.get('City__c');
        project.Fence_PO__c = (String)projectData.get('Fence_PO__c');
        project.Toilet_PO__c = (String)projectData.get('Toilet_PO__c');
        project.Waste_PO__c = (String)projectData.get('Waste_PO__c');
        project.Access_Contact__c =(Id)projectData.get('Access_Contact__c');
        
        insert project;
        return project.Id;
    }
    
    
   @AuraEnabled
    public static User getCurrentUser() {
        return [
            SELECT Id, Name
            FROM User
            WHERE Id = :UserInfo.getUserId()
            LIMIT 1
        ];
    }
    
//============================================================================  Fence  =================================================//
    
  @AuraEnabled(cacheable=true)
    public static Map<String, List<String>> getPicklistValuesFence() {
        Map<String, List<String>> result = new Map<String, List<String>>();

        List<String> enteredBy = new List<String>();
        for (Schema.PicklistEntry entry : Fence_Inventory__c.Entered_By__c.getDescribe().getPicklistValues()) {
            if (entry.isActive()) enteredBy.add(entry.getLabel());
        }
        result.put('Entered_By__c', enteredBy);

        List<String> jobDescription = new List<String>();
        for (Schema.PicklistEntry entry : Fence_Inventory__c.Job_Description__c.getDescribe().getPicklistValues()) {
            if (entry.isActive()) jobDescription.add(entry.getLabel());
        }
        result.put('Job_Description__c', jobDescription);

        return result;
    }
    
   public class FenceInventoryResult {
    @AuraEnabled public Id recordId;
    @AuraEnabled public String workOrderNumber;
    
    public FenceInventoryResult(Id recordId, String workOrderNumber) {
        this.recordId = recordId;
        this.workOrderNumber = workOrderNumber;
    }
}

    @AuraEnabled
    public static FenceInventoryResult createFenceInventory(
        String enteredBy, Id salesPerson, String jobDescription, Id projectId,
        Date serviceDate, String appointmentWindow, String FenceRequirements,
        Id orderBy, String installationInstructions, String SiteAccessinfo, String APPOrderstatus, String Externalemail,Id accessContact
    ) {
        Fence_Inventory__c record = new Fence_Inventory__c();
        record.Entered_By__c = enteredBy;
        record.Job_Description__c = jobDescription;
        record.Project__c = projectId;
        record.Service_Required_On__c = serviceDate;
        record.Appointment_Window__c = appointmentWindow;
        record.Fence_Requirements__c = FenceRequirements;
        record.Ordered_By__c = orderBy;
        record.APP_Order_status__c = APPOrderstatus;
        record.Site_Access_Information__c = SiteAccessinfo;
        record.Install_instr_Fi__c = installationInstructions;
        record.Sales_Person__c = salesPerson;
        record.External_User__c = Externalemail;
        record.Access_Contact__c =accessContact;
        
        insert record;
    
        // Query the Name field after insert
        record = [SELECT Id, Name FROM Fence_Inventory__c WHERE Id = :record.Id];
    
        return new FenceInventoryResult(record.Id, record.Name);
    }



    
