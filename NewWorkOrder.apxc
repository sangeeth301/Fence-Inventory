    @AuraEnabled(cacheable=true)
    public static Map<String, List<String>> getToiletPicklistValues() {
        Map<String, List<String>> result = new Map<String, List<String>>();

        // Get values for Entered_By__c
        List<String> enteredBy = new List<String>();
        for (Schema.PicklistEntry entry : Toilet_Inventory__c.Entered_By__c.getDescribe().getPicklistValues()) {
            if (entry.isActive()) enteredBy.add(entry.getLabel());
        }
        result.put('Entered_By__c', enteredBy);

        // Get values for Status_T__c
        List<String> statusT = new List<String>();
        for (Schema.PicklistEntry entry : Toilet_Inventory__c.Status_T__c.getDescribe().getPicklistValues()) {
            if (entry.isActive()) statusT.add(entry.getLabel());
        }
        result.put('Status_T__c', statusT);

        return result;
    }
       
    
 //==================================================== Waste Disposal ========================================================================================//
 
    @AuraEnabled(cacheable=true)
    public static List<RecordType> getWasteDisposalRecordTypes() {
        return [SELECT Id, Name FROM RecordType WHERE SObjectType = 'Waste_Disposal__c'];
    }

    @AuraEnabled(cacheable=true)
    public static Map<String, List<String>> getPicklistValues() {
        Map<String, List<String>> picklists = new Map<String, List<String>>();
        
        picklists.put('Bin_Size__c', getValues('Waste_Disposal__c', 'Bin_Size__c'));
        picklists.put('Commodity__c', getValues('Waste_Disposal__c', 'Commodity__c'));
        picklists.put('Job_Description__c', getValues('Waste_Disposal__c', 'Job_Description__c'));

        return picklists;
    }

    private static List<String> getValues(String objectName, String fieldName) {
        List<String> values = new List<String>();
        Schema.DescribeFieldResult fieldResult = Schema.getGlobalDescribe().get(objectName).getDescribe().fields.getMap().get(fieldName).getDescribe();
        for (Schema.PicklistEntry entry : fieldResult.getPicklistValues()) {
            values.add(entry.getLabel());
        }
        return values;
    }
    
    public class WasteDisposalResult {
        @AuraEnabled public Id recordId;
        @AuraEnabled public String workOrderNumber;
    
        public WasteDisposalResult(Id recordId, String workOrderNumber) {
            this.recordId = recordId;
            this.workOrderNumber = workOrderNumber;
        }
    }


   @AuraEnabled
    public static WasteDisposalResult createWasteDisposal(Map<String, Object> wasteData) {
        Waste_Disposal__c waste = new Waste_Disposal__c();
        waste.Appointment_Window__c = (String)wasteData.get('appointmentWindow');
        
        String dateStr = (String)wasteData.get('serviceDateWaste');
        if (dateStr != null) {
            waste.Service_Req_on__c = Date.valueOf(dateStr);
        }
        
        waste.Job_Description__c = (String)wasteData.get('jobDescription');
        waste.Bin_Size__c = (String)wasteData.get('binSize');
        waste.Commodity__c = (String)wasteData.get('commodity');
        waste.Project__c = (Id)wasteData.get('projectWaste');
        waste.Ordered_By__c = (String)wasteData.get('orderedByWaste');
        waste.Access_Contact__c = (String)wasteData.get('accessContactWaste');
        waste.Site_Access_Information__c = (String)wasteData.get('siteAccessInformationWaste');
        waste.Installation_Instructions__c = (String)wasteData.get('installationInstructions');
        waste.APP_Order_status__c = (String)wasteData.get('APPOrderstatus');
        waste.External_User__c = (String)wasteData.get('Externalemail');
    
        insert waste;
    
        // Fetch Name field after insert
        waste = [SELECT Id, Name FROM Waste_Disposal__c WHERE Id = :waste.Id];
    
        return new WasteDisposalResult(waste.Id, waste.Name);
    }
    
    //--------------------------------------------------------------------get contacts----------------------------------
        
       @AuraEnabled
    public static List<Contact> getContactsForProject(Id projectId) {
        // Validate input
        if (projectId == null) {
            throw new AuraHandledException('Project Id is required.');
        }
    
        // Fetch the related Account (General Contractor) from Project
        Projects__c proj = [
            SELECT General_Contractor__c 
            FROM Projects__c 
            WHERE Id = :projectId 
            LIMIT 1
        ];
    
        if (proj.General_Contractor__c == null) {
            return new List<Contact>(); // No contractor set on the project
        }
    
        // Fetch contacts related to that Account
        return [
            SELECT Id, Name ,MobilePhone,Phone
            FROM Contact 
            WHERE AccountId = :proj.General_Contractor__c
        ];
    }
    
    
     @AuraEnabled
    public static Contact createContact(Contact con, Id projectId) {
        Id accountId = [
            SELECT General_Contractor__c 
            FROM Projects__c 
            WHERE Id = :projectId 
            LIMIT 1
        ].General_Contractor__c;
        
        con.AccountId = accountId;
        insert con;
        return con;
    }
	
    @AuraEnabled(cacheable=true)
    public static List<Account> getAllAccounts() {
        return [SELECT Id, Name FROM Account ORDER BY Name];
    }
    
    @AuraEnabled(cacheable=true)
    public static List<Projects__c> getProjectsByAccountfront(Id accountId) {
        return [
            SELECT Id, Name 
            FROM Projects__c 
            WHERE General_Contractor__c = :accountId
            ORDER BY Name
        ];
    }
    

